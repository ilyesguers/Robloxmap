# ================= Telegram — هذان فقط إلزاميان على Railway =================
BOT_TOKEN=123456789:AAA...احصل عليه من @BotFather
ADMIN_ID=123456789

# ================= قاعدة البيانات — إلزامي =================
# رابط PostgreSQL من Railway (أو أي مزوّد آخر)
# مثال: postgresql://postgres:password@hostname:port/railway
#
# على Railway: أنشئ Postgres أولاً (New ← Database ← Add PostgreSQL)
# ثم أضف المتغير عبر «Add Variable Reference»:
#     DATABASE_URL = ${{Postgres.DATABASE_URL}}
# ⚠️ لا تنسخ السطر التجريبي أدناه حرفياً — المضيف "host" غير موجود
#    ويسبب الخطأ: socket.gaierror: Name or service not known
# DATABASE_URL=postgresql://user:password@host:5432/database

# ================= كل ما يلي اختياري (له قيم افتراضية جاهزة) =================

# كم إعجاب كحد أقصى لكل جلسة (الحد اليومي للعبة ≈ 100)
# MAX_LIKES_PER_SESSION=100

# تأخير عشوائي بالثواني بين الإعجابات (يقلل خطر الحظر)
# MIN_DELAY_SECONDS=1
# MAX_DELAY_SECONDS=3

# بروكسيات ثابتة مفصولة بفواصل (HTTP/SOCKS5) — اختياري لكنه موصى به بشدة:
# بعد تحديث OB54 قد ترفض Garena تسجيل ضيوف جدد من IP مراكز بيانات Railway
# (error_not_found في السجلات). بتفعيل بروكسي سكني يعمل كل شيء فوراً.
# PROXIES=http://user:pass@host:port,socks5://user:pass@host:port
# أو رابط API بروكسيات دوّارة
# PROXY_API_URL=

# المستخدم ينتظر ساعة بين كل طلب وآخر
# RATE_LIMIT_HOURS=1

# مهلة الاتصال بقاعدة البيانات عند الإقلاع (Postgres قد يستغرق ثواني ليستيقظ)
# DB_CONNECT_RETRIES=5
# DB_CONNECT_RETRY_DELAY=3

# LOG_LEVEL=INFO
