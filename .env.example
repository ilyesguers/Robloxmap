# ================= Telegram =================
BOT_TOKEN=123456789:AAAA...احصل عليه من @BotFather
ADMIN_ID=123456789

# ================= قاعدة البيانات =================
DB_PATH=data/bot.db

# ================= Garena Endpoints =================
# ⚠️ PLACEHOLDERS — استبدلها بالروابط الفعلية الحالية من عميل اللعبة
GUEST_REGISTER_URL=https://YOUR_HOST.garena.com/api/guest/register
GUEST_LOGIN_URL=https://YOUR_HOST.garena.com/api/guest/login
LIKE_URL=https://YOUR_HOST.garena.com/api/like/send
APP_ID=100026
SIGN_SECRET=
API_LANG=en

# ================= منطق الإعجابات =================
MAX_LIKES_PER_SESSION=100
LIKES_PER_GUEST=1
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=6
REQUEST_TIMEOUT=20
MAX_RETRIES=3
PROGRESS_EVERY=10

# ================= بروكسيات =================
# بروكسيات ثابتة مفصولة بفواصل
PROXIES=http://user:pass@host:port,socks5://user:pass@host:port
# أو رابط API يسحب قائمة بروكسيات دوّارة (Webshare/ProxyLite/...)
PROXY_API_URL=
PROXY_REFRESH_SECONDS=300

# ================= حدود الاستخدام =================
RATE_LIMIT_HOURS=1

# ================= أخرى =================
LOG_LEVEL=INFO
