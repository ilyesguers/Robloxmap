# ================= Telegram — هذان فقط إلزاميان على Railway =================
BOT_TOKEN=123456789:AAA...احصل عليه من @BotFather
ADMIN_ID=123456789

# ================= قاعدة البيانات — إلزامي =================
# على Railway: أنشئ Postgres أولاً (New ← Database ← Add PostgreSQL)
# ثم أضف المتغير عبر «Add Variable Reference»:
#     DATABASE_URL = ${{Postgres.DATABASE_URL}}
# ⚠️ لا تنسخ السطر التجريبي أدناه حرفياً — المضيف "host" غير موجود:
# DATABASE_URL=postgresql://user:password@host:5432/database

# ================= بوابة المستوى (OB51+) — الأهم =================
# الإعجابات لا تُحتسب إلا من حسابات بمستوى ≥ هذه القيمة
# MIN_DONOR_LEVEL=8
# مستوى «المرسل الكامل» — تجاوز سقف ~20 إعجاباً محتسباً يومياً للهدف
# FULL_LIKE_LEVEL=22
# كل حساب يعجب بنفس الهدف مرة كل هذه الساعات (تصفير Garena اليومي)
# LIKE_COOLDOWN_HOURS=20

# ================= الحدود والتأخيرات (اختياري) =================
# MAX_LIKES_PER_SESSION=100
# MIN_DELAY_SECONDS=1
# MAX_DELAY_SECONDS=3
# RATE_LIMIT_HOURS=1
# DONATE_MAX_LINES=5

# ================= بروكسيات (موصى به بشدة) =================
# IP مراكز بيانات Railway غالباً مرفوض من Garena لتسجيل الضيوف/القراءة:
# PROXIES=http://user:pass@host:port,socks5://user:pass@host:port
# PROXY_API_URL=

# ================= أخرى =================
# DB_CONNECT_RETRIES=5
# DB_CONNECT_RETRY_DELAY=3
# LOG_LEVEL=INFO
# RELEASE_VERSION=OB54
